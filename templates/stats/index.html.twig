{% extends 'base.html.twig' %}

{% block title %}{{ 'Statistiques'|trans }} · {{ 'Univers de Nico'|trans }}{% endblock %}

{% block description %}{{ 'Les visites du site, en toute transparence : sans cookie, sans adresse IP, seulement des totaux.'|trans }}{% endblock %}

{% block body %}
{% set mois = jours|reduce((somme, n) => somme + n, 0) %}
{% set pic = max(1, max(jours)) %}
<article class="projet container py-5">
  <header class="projet-entete">
    <h1 class="gradient fw-bold">{{ 'Statistiques'|trans }}</h1>
    <p class="projet-chapo">{{ 'Les visites du site, en toute transparence : sans cookie, sans adresse IP, seulement des totaux.'|trans }}
      <a href="{{ path('app_confidentialite') }}">{{ 'Confidentialité'|trans }}</a></p>
  </header>

  <div class="stats-chiffres">
    <p><strong>{{ mois|format_number(locale: app.request.locale) }}</strong> {{ 'pages vues ces 30 derniers jours'|trans }}</p>
    <p><strong>{{ total|format_number(locale: app.request.locale) }}</strong> {{ 'pages vues en tout'|trans }}{% if depuis %}, {{ 'depuis le'|trans }} {{ depuis|format_date('long', locale: app.request.locale) }}{% endif %}</p>
  </div>

  <h2 class="stats-titre">{{ '30 derniers jours'|trans }}</h2>
  <ol class="stats-jours">
    {% for jour, nombre in jours %}
    <li style="--part: {{ (nombre / pic * 100)|round }}%" title="{{ jour|format_date('medium', locale: app.request.locale) }} : {{ nombre }}">
      <span class="visually-hidden">{{ jour|format_date('medium', locale: app.request.locale) }} : {{ nombre }}</span>
    </li>
    {% endfor %}
  </ol>

  {# Globe des arrivées (globe_controller.js) : décor, la liste « D'où l'on arrive » dit la même chose #}
  <section class="stats-globe" data-controller="globe" data-globe-url-value="{{ path('app_arrivees') }}" aria-hidden="true" hidden>
    <h2 class="stats-titre">{{ 'Arrivées sur le site'|trans }} · <span data-globe-target="total">0</span></h2>
    <p class="stats-globe-aide">{{ 'Chaque colonne est un fuseau horaire : celui du navigateur des visiteurs arrivés ces 30 derniers jours. Une onde s’allume à chaque nouvelle arrivée.'|trans }} {{ 'Les points bleus : le lieu approché d’après l’adresse IP, souvent la ville de l’opérateur.'|trans }}</p>
    <div class="stats-globe-scene" data-globe-target="scene"></div>
    <span class="systeme-etiquette" data-globe-target="label" hidden></span>
  </section>
  {# Licence CC BY 4.0 de la base DB-IP Lite ; hors de la section aria-hidden, pour que le lien reste accessible #}
  <p class="stats-globe-aide"><a href="https://db-ip.com" rel="noopener">IP Geolocation by DB-IP</a></p>

  <div class="stats-listes">
    <section>
      <h2 class="stats-titre">{{ 'Pages les plus vues'|trans }}</h2>
      <ol>
        {% for chemin, nombre in pages %}<li><a href="{{ app.request.locale == 'fr' ? chemin : '/' ~ app.request.locale ~ (chemin == '/' ? '' : chemin) }}">{{ chemin }}</a> <span>{{ nombre }}</span></li>
        {% else %}<li>{{ 'Pas encore de visite.'|trans }}</li>{% endfor %}
      </ol>
    </section>
    <section>
      <h2 class="stats-titre">{{ 'D’où l’on arrive'|trans }}</h2>
      <ol>
        {% for fuseau, nombre in fuseaux %}<li>{{ fuseau|split('/')|last|replace({'_': ' '}) }} <span>{{ nombre }}</span></li>
        {% else %}<li>{{ 'Pas encore de visite.'|trans }}</li>{% endfor %}
      </ol>
    </section>
    <section>
      <h2 class="stats-titre">{{ 'Langues'|trans }}</h2>
      <ul>
        {% for langue, nombre in langues %}<li>{{ langue|language_name(app.request.locale)|capitalize }} <span>{{ (nombre / max(1, mois) * 100)|round }} %</span></li>
        {% else %}<li>{{ 'Pas encore de visite.'|trans }}</li>{% endfor %}
      </ul>
    </section>
  </div>
</article>
{% endblock %}
