{% extends 'base.html.twig' %}

{% block title %}Nicolas Cataluna - {{ profil|loc('titre') }}{% endblock %}

{% block description %}{{ 'CV en ligne de Nicolas Cataluna, développeur fullstack, téléchargeable en PDF (thème clair ou sombre).'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/pages/cv.css') }}">
    {# Appliqué avant l'affichage pour éviter un flash du mauvais thème #}
    <script>document.documentElement.dataset.theme = localStorage.getItem('theme') || 'dark';</script>
{% endblock %}

{% block body %}
<div class="cv-page" data-controller="cv" data-cv-download-url-value="{{ path('app_cv_download') }}"
     data-cv-texts-value="{{ {light: 'Mode Clair'|trans, dark: 'Mode Sombre'|trans, generating: 'Génération…'|trans}|json_encode }}">
    <!-- Download Button -->
    <button class="download-button" id="downloadButton" data-action="cv#download" data-cv-target="download" aria-label="{{ 'Télécharger le CV'|trans }}">
        <span class="download-icon">{{ ux_icon('bi:download', {'height': '20px', 'width': '20px'}) }}</span>
        <span>{{ 'Télécharger le CV'|trans }}</span>
    </button>

    <!-- Toggle Theme Button -->
    <button class="theme-toggle" id="themeToggle" data-action="cv#toggleTheme" aria-label="{{ 'Changer le thème'|trans }}">
        <span class="theme-toggle-icon" id="themeIcon">
            <span data-cv-target="iconSun" hidden>{{ ux_icon('bi:sun-fill', {'height': '20px', 'width': '20px'}) }}</span>
            <span data-cv-target="iconMoon">{{ ux_icon('bi:moon-fill', {'height': '20px', 'width': '20px'}) }}</span>
        </span>
        <span class="theme-toggle-text" id="themeText" data-cv-target="themeText">{{ 'Mode Clair'|trans }}</span>
    </button>

    <div class="stars" id="stars" data-cv-target="stars"></div>
    <div class="planet"></div>

    <div class="container">
        {{ include('cv/_contenu.html.twig', {pdf: false}) }}
    </div>
</div>
{% endblock %}
