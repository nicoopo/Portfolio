<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="UTF-8">
    <title>Nicolas Cataluna - {{ profil|loc('titre') }}</title>
    <style>
        {% if theme == 'dark' %}
        :root {
            --bg-primary: #000000;
            --bg-secondary: #0a0a0a;
            --bg-tertiary: #000000;
            --bg-card: rgba(20, 20, 20, 0.9);
            --bg-card-hover: rgba(255, 255, 255, 0.05);
            --text-primary: #e0e0e0;
            --text-secondary: #b0b0b0;
            --accent-primary: #6495ed;
            --accent-secondary: #87ceeb;
            --accent-tertiary: #4169e1;
            --border-color: rgba(100, 149, 237, 0.3);
            --shadow-color: rgba(100, 149, 237, 0.2);
            --tag-bg: rgba(100, 149, 237, 0.2);
            --success-color: #90ee90;
            --success-bg: rgba(50, 205, 50, 0.2);
            --success-border: rgba(50, 205, 50, 0.5);
        }
        {% else %}
        :root {
            --bg-primary: #ffffff;
            --bg-secondary: #f8f9fa;
            --bg-tertiary: #ffffff;
            --bg-card: rgba(255, 255, 255, 0.95);
            --bg-card-hover: rgba(100, 149, 237, 0.08);
            --text-primary: #1a1a1a;
            --text-secondary: #4a5568;
            --accent-primary: #2563eb;
            --accent-secondary: #1e40af;
            --accent-tertiary: #3b82f6;
            --border-color: rgba(37, 99, 235, 0.3);
            --shadow-color: rgba(37, 99, 235, 0.15);
            --tag-bg: rgba(37, 99, 235, 0.15);
            --success-color: #059669;
            --success-bg: rgba(16, 185, 129, 0.15);
            --success-border: rgba(16, 185, 129, 0.4);
        }
        {% endif %}

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'DejaVu Sans', Arial, sans-serif;
            background: var(--bg-primary);
            color: var(--text-primary);
            font-size: 8pt;
            line-height: 1.3;
        }

        .container {
            max-width: 100%;
            padding: 5mm;
        }

        .header {
            text-align: center;
            padding: 8mm 5mm;
            background: var(--bg-card);
            border-radius: 8px;
            border: 2px solid var(--border-color);
            margin-bottom: 4mm;
        }

        h1 {
            font-size: 18pt;
            margin-bottom: 2mm;
            color: var(--accent-primary);
            font-weight: bold;
        }

        .subtitle {
            font-size: 11pt;
            color: var(--accent-secondary);
            margin-bottom: 3mm;
        }

        .tags {
            display: flex;
            gap: 2mm;
            justify-content: center;
            flex-wrap: wrap;
            margin: 2mm 0;
        }

        .tag {
            background: var(--tag-bg);
            padding: 1mm 3mm;
            border-radius: 8px;
            border: 1px solid var(--border-color);
            font-size: 7pt;
            color: var(--accent-secondary);
        }

        .contact-info {
            display: flex;
            gap: 3mm;
            justify-content: center;
            flex-wrap: wrap;
            margin-top: 3mm;
            font-size: 7pt;
        }

        .contact-item {
            color: var(--text-secondary);
        }

        .section {
            background: var(--bg-card);
            border-radius: 6px;
            padding: 2.5mm 3mm;
            margin-bottom: 2mm;
            border: 1px solid var(--border-color);
        }

        /* Les compétences ouvrent la page 2 : sinon leur titre reste seul en bas de la page 1 */
        .section-competences {
            page-break-before: always;
        }

        /* Une section peut continuer sur la page suivante (sinon un bloc entier part à la page d'après
           et laisse un grand vide) ; ses éléments, eux, ne sont jamais coupés */
        .skill-category, .language-item {
            page-break-inside: avoid;
        }

        .section-title {
            font-size: 12pt;
            margin-bottom: 2mm;
            color: var(--accent-primary);
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 1mm;
        }

        .experience-item, .formation-item {
            margin-bottom: 1.5mm;
            padding: 1.5mm 2mm;
            background: var(--bg-card-hover);
            border-radius: 4px;
            border-left: 3px solid var(--accent-primary);
            page-break-inside: avoid;
        }

        /* Anciens styles en ligne, devenus des classes (contenu partagé avec la page : cv/_contenu) */
        .profile-text {
            line-height: 1.4;
            margin-bottom: 2mm;
            font-size: 7pt;
        }

        .profile-highlight {
            color: var(--accent-secondary);
            font-weight: bold;
            font-size: 7pt;
        }

        .experience-header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 2mm;
        }

        .experience-title {
            font-size: 9pt;
            color: var(--accent-secondary);
            font-weight: bold;
        }

        .experience-company {
            color: var(--accent-primary);
            font-weight: 600;
            margin-top: 0.5mm;
            font-size: 8pt;
        }

        .experience-site {
            display: block;
            margin-top: 0.3mm;
            color: var(--accent-primary);
            font-size: 6.5pt;
            text-decoration: underline;
        }

        .experience-period {
            color: var(--text-secondary);
            font-size: 7pt;
        }

        .experience-description {
            list-style: none;
            margin-top: 1mm;
        }

        .experience-description li {
            padding-left: 4mm;
            margin-bottom: 0.5mm;
            position: relative;
            line-height: 1.3;
            color: var(--text-primary);
        }

        .experience-description li::before {
            content: '▸';
            position: absolute;
            left: 0;
            color: var(--accent-primary);
            font-weight: bold;
        }

        .skills-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 2mm;
        }

        .skill-category {
            background: var(--bg-card-hover);
            padding: 2mm;
            border-radius: 4px;
            border: 1px solid var(--border-color);
        }

        .skill-category-title {
            color: var(--accent-secondary);
            font-size: 8pt;
            margin-bottom: 1mm;
            font-weight: bold;
        }

        .skill-list {
            display: flex;
            flex-wrap: wrap;
            gap: 1mm;
        }

        .skill-item {
            background: var(--tag-bg);
            padding: 0.5mm 2mm;
            border-radius: 6px;
            font-size: 6pt;
            border: 1px solid var(--border-color);
            color: var(--text-primary);
        }

        .formation-title {
            font-size: 8pt;
            color: var(--accent-secondary);
            margin-bottom: 0.5mm;
            font-weight: bold;
        }

        .formation-school {
            color: var(--accent-primary);
            margin-bottom: 0.5mm;
            font-size: 7pt;
        }

        .formation-period {
            color: var(--text-secondary);
            font-size: 7pt;
        }

        .formation-status {
            display: inline-block;
            margin-top: 1mm;
            padding: 0.5mm 2mm;
            background: var(--success-bg);
            border: 1px solid var(--success-border);
            border-radius: 6px;
            color: var(--success-color);
            font-size: 6pt;
            font-weight: 600;
        }

        /* Dompdf ne gère pas display: grid (tout s'empilait) : colonnes en inline-block */
        .languages-grid,
        .interests-grid {
            font-size: 0; /* pas d'espace entre les blocs inline-block */
        }

        .language-item {
            display: inline-block;
            width: 21%; /* Dompdf ignore box-sizing : padding et bordure s'ajoutent, d'où la marge de sécurité */
            margin-right: 2%;
            vertical-align: top;
            box-sizing: border-box;
            font-size: 7pt;
            background: var(--bg-card-hover);
            padding: 2mm;
            border-radius: 4px;
            text-align: center;
            border: 1px solid var(--border-color);
        }

        .language-name {
            font-size: 8pt;
            color: var(--accent-secondary);
            margin-bottom: 0.5mm;
            font-weight: bold;
        }

        .language-level {
            color: var(--text-secondary);
            font-size: 7pt;
        }

        .language-item:last-child {
            margin-right: 0;
        }

        .interest-item {
            display: inline-block;
            width: 45%; /* idem : padding et bordure en plus */
            margin: 0 2% 1mm 0;
            vertical-align: top;
            box-sizing: border-box;
            font-size: 7pt;
            background: var(--bg-card-hover);
            padding: 1mm 2mm;
            border-radius: 4px;
            border-left: 2px solid var(--accent-primary);
            color: var(--text-primary);
            font-size: 7pt;
        }

        @page {
            margin: 0;
            size: A4 portrait;
        }
    </style>
</head>
<body>
    <div class="container">
        {{ include('cv/_contenu.html.twig', {pdf: true}) }}
    </div>
</body>
</html>

