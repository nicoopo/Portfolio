{% extends 'base.html.twig' %}

{% block title %}{{ 'Mes Projets - Portfolio'|trans }}{% endblock %}

{% block description %}{{ 'Mes projets en Java, PHP / Symfony et réseau : descriptions, captures et compétences utilisées.'|trans }}{% endblock %}

{% block body %}
<section class="projets container py-5">
  <h1 class="text-center gradient fw-bold display-5">{{ 'Mes Projets'|trans }}</h1>
  <p class="projets-intro">{{ 'Clique sur un projet pour le découvrir en détail.'|trans }}
    <a href="{{ path('app_projects_frise') }}">{{ 'Voir mes projets dans le temps'|trans }} →</a></p>

  {# Les projets en orbite autour d'un trou noir. Décor : les mêmes liens sont dans la liste en dessous #}
  <div class="projets-orbite" data-controller="orbite" aria-hidden="true">
    <canvas data-orbite-target="canvas"></canvas>
    {% for projets in categories %}{% for projet in projets %}
    <a class="orbite-projet" href="{{ path('app_project', {slug: projet.slug}) }}" tabindex="-1" data-orbite-target="projet">
      {% if projet.imageChemin %}<img src="{{ asset(projet.imageChemin) }}" alt="" loading="lazy">{% endif %}
      <span>{{ projet|loc('titre') }}</span>
    </a>
    {% endfor %}{% endfor %}
  </div>

  {% for categorie, projets in categories %}
  <section class="projets-groupe" aria-labelledby="groupe-{{ loop.index }}">
    <h2 class="projets-groupe-titre" id="groupe-{{ loop.index }}">
      {{ projets|first|loc('categorie') }}
      <span class="projets-groupe-nombre">{{ projets|length }}</span>
    </h2>

    <div class="projets-grille">
      {% for projet in projets %}
      {# Toute la carte est cliquable (lien étiré sur le titre) ; id = ancre des anciens liens /projects#slug #}
      <article class="projet-carte" id="{{ projet.slug }}">
        {% if projet.imageChemin %}
        <div class="projet-carte-image">
          <img src="{{ asset(projet.imageChemin) }}" alt="" loading="lazy">
        </div>
        {% endif %}
        <div class="projet-carte-corps">
          <h3 class="projet-carte-titre">
            <a href="{{ path('app_project', {slug: projet.slug}) }}">{{ projet|loc('titre') }}</a>
          </h3>
          <p class="projet-carte-description">{{ projet|loc('description') }}</p>
          <ul class="projet-techs" aria-label="{{ 'Technologies'|trans }}">
            {% for tech in projet.tech|split(',') %}<li>{{ tech|trim }}</li>{% endfor %}
          </ul>
          <span class="projet-carte-suite" aria-hidden="true">{{ 'Voir le projet'|trans }} →</span>
        </div>
      </article>
      {% endfor %}
    </div>
  </section>
  {% endfor %}

  {# Derniers dépôts publics (App\Service\ActiviteGithub, cache d'une heure) ; GitHub indisponible : rien #}
  {% if depots is not empty %}
  <section class="projets-groupe" aria-labelledby="groupe-github">
    <h2 class="projets-groupe-titre" id="groupe-github">{{ 'Activité récente sur GitHub'|trans }}</h2>
    <div class="projets-grille">
      {% for depot in depots %}
      <article class="projet-carte">
        <div class="projet-carte-corps">
          <h3 class="projet-carte-titre"><a href="{{ depot.url }}" rel="noopener">{{ depot.nom }}</a></h3>
          {% if depot.description %}<p class="projet-carte-description">{{ depot.description }}</p>{% endif %}
          {% if depot.langage %}<ul class="projet-techs" aria-label="{{ 'Technologies'|trans }}"><li>{{ depot.langage }}</li></ul>{% endif %}
          <span class="projet-carte-suite">{{ 'Mis à jour le'|trans }} <time datetime="{{ depot.misAJour }}">{{ depot.misAJour|format_date('long', locale: app.request.locale) }}</time></span>
        </div>
      </article>
      {% endfor %}
    </div>
  </section>
  {% endif %}
</section>
{% endblock %}
