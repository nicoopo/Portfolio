{% extends 'base.html.twig' %}

{% block title %}Informação legal - Nicolas Cataluna{% endblock %}

{% block description %}Informação legal de nicolascataluna.fr: editor, diretor da publicação e alojamento.{% endblock %}

{% block body %}
<section class="legal-section">
