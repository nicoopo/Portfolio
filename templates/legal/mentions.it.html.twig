{% extends 'base.html.twig' %}

{% block title %}Note legali - Nicolas Cataluna{% endblock %}

{% block description %}Note legali di nicolascataluna.fr: editore, direttore della pubblicazione e hosting.{% endblock %}

{% block body %}
