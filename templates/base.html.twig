<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Univers de Nico{% endblock %}</title>
    <link rel="icon" href="{{ asset('images/nico-symbol.svg') }}">
    {% block javascripts %}
        {# Charge aussi app.js → bootstrap.css + styles/app.css #}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
    {# CSS propre à une page : après app.css pour pouvoir le surcharger #}
    {% block stylesheets %}{% endblock %}
</head>

<body>
    <nav class="navbar-galactic">
        <div class="navbar-container">
            <a href="{{ path('app_home') }}" class="logo gradient">
                <img src="{{ asset('images/nico-symbol.svg') }}" class="logo-sm" alt="">
            </a>

            <!-- 🌌 Menu icon -->
            <div class="dropdown">
                <button type="button" class="menu-button" id="menuToggle">
                    {{ ux_icon('bi:menu-app-fill', {'height': '32px', 'width': '32px', 'color': '#cfe9ff'}) }}
                </button>

                <!-- Menu déroulant -->
                <ul class="dropdown-menu-galactic" id="menuDropdown">
                    <li><a href="{{ path('app_home') }}">Accueil</a></li>
                    <li><a href="{{ path('app_cerveau') }}">Mon Cerveau</a></li>
                    <li><a href="{{ path('app_projects') }}">Projets</a></li>
                    <li><a href="{{ path('app_univers') }}">Mon Univers</a></li>
                    <li><a href="{{ path('app_competences') }}">Compétences</a></li>
                    <li><a href="{{ path('app_contact') }}">Contact</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <main>
        {% block body %}
        {% endblock %}
    </main>
</body>
</html>
