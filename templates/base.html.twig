{# Langue de la page ; les autres langues (global « langues_site » = framework.enabled_locales) : même route, mêmes paramètres #}
{% set locale = app.request.locale %}
{% set noms_langues = {fr: 'Français', en: 'English', es: 'Español', de: 'Deutsch', it: 'Italiano', pt: 'Português'} %}
{# _route est déjà le nom sans suffixe de langue (app_contact, pas app_contact.en) ; absent sur une page d'erreur #}
{% set canonical_route = app.request.attributes.get('_route') %}
{% set route_params = app.request.attributes.get('_route_params', {}) %}
{% macro url_in(locale, canonical_route, route_params) -%}
    {{ canonical_route ? url(canonical_route, route_params|merge({_locale: locale})) : url('app_home', {_locale: locale}) }}
{%- endmacro %}
<!DOCTYPE html>
<html lang="{{ locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ 'Univers de Nico'|trans }}{% endblock %}</title>
    <meta name="description" content="{% block description %}{{ 'Portfolio de Nicolas Cataluna, développeur fullstack PHP / Symfony : compétences, projets, parcours, et un cerveau 3D interactif pour tout explorer.'|trans }}{% endblock %}">
    {# Aperçu des liens partagés (LinkedIn, Discord, Slack…) #}
    {% set page_url = app.request.schemeAndHttpHost ~ app.request.pathInfo %}
    <link rel="canonical" href="{{ page_url }}">
    {# Les deux versions de la page, pour les moteurs de recherche #}
    {% for langue in langues_site %}
    <link rel="alternate" hreflang="{{ langue }}" href="{{ _self.url_in(langue, canonical_route, route_params) }}">
    {% endfor %}
    <link rel="alternate" hreflang="x-default" href="{{ _self.url_in('fr', canonical_route, route_params) }}">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{ 'Univers de Nico'|trans }}">
    <meta property="og:locale" content="{{ {fr: 'fr_FR', en: 'en_GB', es: 'es_ES', de: 'de_DE', it: 'it_IT', pt: 'pt_PT'}[locale] }}">
    <meta property="og:title" content="{{ block('title')|trim }}">
    <meta property="og:description" content="{{ block('description')|trim }}">
    <meta property="og:url" content="{{ page_url }}">
    {% block og_image %}
    <meta property="og:image" content="{{ absolute_url(asset('images/og-cerveau.jpg')) }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    {% endblock %}
    <meta name="twitter:card" content="summary_large_image">
    <link rel="icon" href="{{ asset('images/nico-symbol.svg') }}">
    {% block javascripts %}
        {# Charge aussi app.js → bootstrap.css + styles/app.css #}
        {% block importmap %}{{ importmap('app', {nonce: csp_nonce('script')}) }}{% endblock %}
    {% endblock %}
    {# CSS propre à une page : après app.css pour pouvoir le surcharger #}
    {% block stylesheets %}{% endblock %}
</head>

<body>
    <nav class="navbar-galactic">
        <div class="navbar-container">
            <a href="{{ path('app_home') }}" class="logo gradient" aria-label="{{ 'Accueil'|trans }}">
                <img src="{{ asset('images/nico-symbol.svg') }}" class="logo-sm" width="40" height="40" alt="">
            </a>

            <div class="navbar-actions">
                {# Langues : la même page dans chaque langue, chaque nom écrit dans sa propre langue #}
                <button type="button" class="lang-switch" popovertarget="langues" aria-label="{{ 'Langue'|trans }} : {{ noms_langues[locale] }}">{{ locale|upper }}</button>
                <ul id="langues" class="langues" popover>
                    {% for langue in langues_site %}
                    <li><a href="{{ _self.url_in(langue, canonical_route, route_params) }}" hreflang="{{ langue }}" lang="{{ langue }}"
                           {% if langue == locale %}aria-current="true"{% endif %}>{{ noms_langues[langue] }}</a></li>
                    {% endfor %}
                </ul>

                {# Réglages : panneau natif (popover), fermé par Échap ou un clic ailleurs #}
                <button type="button" class="menu-button" popovertarget="reglages" aria-label="{{ 'Réglages'|trans }}">
                    {{ ux_icon('bi:gear-fill') }}
                </button>
                <div id="reglages" class="reglages" popover>
                    <p class="reglages-titre">{{ 'Réglages'|trans }}</p>
                    <label class="interrupteur">
                        <span>{{ 'Effets trou noir'|trans }}<small>{{ 'Transitions entre les pages, easter eggs'|trans }}</small></span>
                        <input type="checkbox" role="switch" id="prefTransitions">
                    </label>
                    <label class="interrupteur">
                        <span>{{ 'Haute qualité'|trans }}<small>{{ 'À couper si le site rame'|trans }}</small></span>
                        <input type="checkbox" role="switch" id="prefQualite">
                    </label>
                    <label class="interrupteur">
                        <span>{{ 'Son'|trans }}<small>{{ 'Ambiance sonore du cerveau 3D'|trans }}</small></span>
                        <input type="checkbox" role="switch" id="prefSon">
                    </label>
                    <fieldset class="choix-curseur">
                        <legend>{{ 'Curseur'|trans }}</legend>
                        {% for valeur, label in {comete: 'Comète', orbite: 'Orbite', 'trou-noir': 'Trou noir', systeme: 'Classique'} %}
                            <label><input type="radio" name="curseur" value="{{ valeur }}"> {{ label|trans }}</label>
                        {% endfor %}
                    </fieldset>
                    {# Carnet des easter eggs (decouvertes.js) : un indice tant qu'ils ne sont pas trouvés #}
                    <div class="decouvertes">
                        <p class="decouvertes-titre">{{ 'Découvertes'|trans }} <span id="decouvertesCompte"></span></p>
                        <ul>
                            {% for id, decouverte in {
                                'trou-noir': {nom: 'Le trou noir de poche', indice: 'Reste appuyé dans le vide…'},
                                'konami': {nom: 'La pluie de météores', indice: 'Un vieux code de jeu vidéo, au clavier…'},
                                'constellation-n': {nom: 'La constellation N', indice: 'Une initiale cachée dans le ciel…'},
                                'constellation-lion': {nom: 'La constellation du Lion', indice: 'Un signe du zodiaque dans le ciel…'},
                            } %}
                                <li data-decouverte="{{ id }}">
                                    <span class="decouverte-nom">{{ decouverte.nom|trans }}</span>
                                    <span class="decouverte-indice">{{ decouverte.indice|trans }}</span>
                                </li>
                            {% endfor %}
                        </ul>
                        <p id="decouvertesBravo" class="decouvertes-bravo" hidden>✦ {{ 'Explorateur de l’univers : tout est trouvé !'|trans }} ✦</p>
                    </div>
                </div>

                <button type="button" class="menu-button" popovertarget="menu" aria-label="{{ 'Menu'|trans }}">
                    {{ ux_icon('bi:menu-app-fill') }}
                </button>
            </div>

            {# Menu plein écran #}
            <nav id="menu" class="menu-galactic" popover aria-label="{{ 'Menu'|trans }}">
                <button type="button" class="menu-button menu-fermer" popovertarget="menu" popovertargetaction="hide" aria-label="{{ 'Fermer le menu'|trans }}">
                    {{ ux_icon('bi:x-lg') }}
                </button>
                <ul>
                    {% for route, label in {
                        app_home: 'Accueil',
                        app_cerveau: 'Mon Cerveau',
                        app_projects: 'Projets',
                        app_univers: 'Mon Univers',
                        app_competences: 'Compétences',
                        app_contact: 'Contact',
                    } %}
                        <li style="--i: {{ loop.index0 }}">
                            <a href="{{ path(route) }}" {% if canonical_route == route %}aria-current="page"{% endif %}>{{ label|trans }}</a>
                        </li>
                    {% endfor %}
                </ul>
            </nav>
        </div>
    </nav>

    {# Nouvelle découverte d'un easter egg (decouvertes.js) #}
    <p id="decouverte" class="decouverte-toast" role="status" hidden>
        ✦ {{ 'Nouvelle découverte'|trans }} : <strong data-nom></strong> (<span data-compte></span>)
        <span data-bravo hidden>— {{ 'tout est trouvé, bravo !'|trans }}</span> ✦
    </p>

    {# Proposé par qualite_auto.js quand le site rame #}
    <div id="qualiteAuto" class="qualite-auto" role="status" hidden>
        <p>{{ "Le site a l'air de ramer sur cet appareil. Passer en qualité basse ?"|trans }}</p>
        <div class="qualite-auto-actions">
            <button type="button" data-qualite="basse">{{ 'Passer en qualité basse'|trans }}</button>
            <button type="button" data-qualite="garder">{{ 'Non merci'|trans }}</button>
        </div>
        <small>{{ 'Modifiable à tout moment dans les réglages ⚙'|trans }}</small>
    </div>

    <main>
        {% block body %}
        {% endblock %}
    </main>

    <footer class="site-footer">
        <span>© {{ 'now'|date('Y') }} Nicolas Cataluna</span>
        <a href="{{ path('app_mentions_legales') }}">{{ 'Mentions légales'|trans }}</a>
        <a href="{{ path('app_confidentialite') }}">{{ 'Confidentialité'|trans }}</a>
    </footer>
</body>
</html>
