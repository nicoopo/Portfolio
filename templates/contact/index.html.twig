{% extends 'base.html.twig' %}

{% block title %}{{ 'Contact'|trans }} · Nicolas Cataluna{% endblock %}

{% block description %}{{ 'Me contacter : e-mail, GitHub, LinkedIn ou CV numérique.'|trans }}{% endblock %}

{% block body %}
    <section class="contact-section">
        <div class="contact-container">
            <h1>{{ 'Contact'|trans }}</h1>
            <p class="contact-subtitle">
            {{ 'Pour toute prise de contact, opportunité d’alternance ou échange professionnel,'|trans }}<br>
            {{ 'vous pouvez me joindre directement par mail ou via mes profils ci-dessous.'|trans }}
            </p>

            <div class="contact-links">
            <!-- Mail -->
            <a href="mailto:{{ contact_email }}?subject=Contact%20depuis%20le%20portfolio"
                class="contact-item" title="{{ 'Envoyer un mail'|trans }}">
                {{ ux_icon('fluent:mail-add-24-filled', {'height': '28px', 'width': '28px', 'aria-hidden': 'true'}) }}
                <span>{{ 'Mail'|trans }}</span>
            </a>

            <!-- CV numérique -->
            <a href="{{ path('app_cv') }}" target="_blank" class="contact-item" title="{{ 'Voir mon CV numérique'|trans }}">
                {{ ux_icon('pepicons-pop:cv-circle', {'height': '28px', 'width': '28px', 'aria-hidden': 'true'}) }}
                <span>{{ 'Mon CV numérique'|trans }}</span>
            </a>

            <!-- GitHub -->
            <a href="https://github.com/nicoopo" target="_blank" class="contact-item" title="GitHub">
                {{ ux_icon('iconoir:github', {'height': '28px', 'width': '28px', 'aria-hidden': 'true'}) }}
                <span>GitHub</span>
            </a>

            <!-- LinkedIn -->
            <a href="https://www.linkedin.com/in/nicolas-cataluna-737182224/" target="_blank" class="contact-item" title="LinkedIn">
                {{ ux_icon('streamline-pixel:logo-linkedin', {'height': '28px', 'width': '28px', 'aria-hidden': 'true'}) }}
                <span>LinkedIn</span>
            </a>

            </div>

            {# Serveur MCP (App\Mcp\Portfolio) : adresse absolue, à copier dans les réglages de l'assistant #}
            <p class="contact-mcp">{{ 'Votre assistant IA (Claude, ChatGPT…) peut aussi interroger mon profil : ajoutez le serveur MCP'|trans }}
                <code>{{ url('_mcp_endpoint_default') }}</code></p>

            <h2 class="contact-form-title" id="formulaire">{{ 'Ou écrivez-moi ici'|trans }}</h2>

            {% for type, messages in app.flashes(['success', 'error']) %}
                {% for message in messages %}
                <p class="contact-flash contact-flash--{{ type }}" role="{{ type == 'error' ? 'alert' : 'status' }}">{{ message }}</p>
                {% endfor %}
            {% endfor %}

            {# form : le formulaire refusé par le contrôleur, pour réafficher ses erreurs #}
            {{ component('ContactFormulaire', {form: form}) }}
        </div>
    </section>
{% endblock %}
