{% extends 'base.html.twig' %}

{% block body %}
<div class="hero-container">
    <div class="hero-content fade-in-up">

        {# Lien recruteur (/?pour=code, HomeController) : bonjour personnalisé et l'essentiel en deux clics #}
        {% if recruteur %}
        <aside class="recruteur" aria-label="{{ 'Message pour vous'|trans }}">
            <p class="recruteur-bonjour">{{ 'Bonjour l’équipe de %entreprise% !'|trans({'%entreprise%': recruteur.entreprise}) }}</p>
            <p>{{ recruteur.poste
                ? 'Merci de votre visite. Tout ce qu’il faut savoir pour le poste de %poste% est à deux clics :'|trans({'%poste%': recruteur.poste})
                : 'Merci de votre visite. L’essentiel est à deux clics :'|trans }}</p>
            {% if recruteur.message %}<p class="recruteur-message">{{ recruteur.message|nl2br }}</p>{% endif %}
            <div class="recruteur-actions">
                <a href="{{ path('app_cv') }}" class="btn btn-galactic btn-galactic-primary">{{ 'Mon CV'|trans }}</a>
                <a href="{{ path('app_comparateur') }}" class="btn btn-galactic btn-galactic-outline-light">{{ 'Comparer avec votre offre'|trans }}</a>
                <a href="{{ path('app_contact') }}" class="btn btn-galactic btn-galactic-outline-light">{{ 'Me contacter'|trans }}</a>
            </div>
        </aside>
        {% endif %}

        <h1 class="title">
            {{ 'BIENVENUE DANS'|trans }}<br>
            <span class="gradient">{{ "L'UNIVERS"|trans }}</span><br>
            {{ 'DE NICOLAS'|trans }}
        </h1>

        <p class="subtitle">
            {{ 'Ici, code, curiosité et créativité gravitent ensemble.'|trans }}
        </p>

        <div class="typing-container">
            <span class="static-text">{{ 'Je suis'|trans }} </span>
            <span class="typing-text" id="typing-text"
                  data-controller="typing"
                  data-typing-words-value="{{ ['Développeur Web'|trans, 'Passionné de Tech'|trans, 'Créateur Digital'|trans]|json_encode }}"></span><span class="cursor"></span>
        </div>

        <div class="cta-container">
            <a href="{{ path('app_projects') }}" class="btn btn-galactic btn-galactic-outline-light">
                {{ 'Explorer mon travail'|trans }}
            </a>
            <a href="{{ path('app_cerveau') }}" class="btn btn-galactic btn-galactic-primary">
                {{ 'Entrer dans mon cerveau'|trans }}
            </a>
            <button type="button" class="btn btn-galactic btn-galactic-outline-light" data-visite-demarrer>
                {{ 'Visite en 1 minute'|trans }}
            </button>
        </div>

        <div class="hero-cards">
            <a href="{{ path('app_projects') }}" class="hero-card">
                <div class="card-icon">{{ ux_icon('bi:code-slash', {height: '32px', width: '32px'}) }}</div>
                <span>{{ 'Projets'|trans }}</span>
            </a>
            <a href="{{ path('app_competences') }}" class="hero-card">
                <div class="card-icon">{{ ux_icon('bi:cpu', {height: '32px', width: '32px'}) }}</div>
                <span>{{ 'Compétences'|trans }}</span>
            </a>
            <a href="{{ path('app_univers') }}" class="hero-card">
                <div class="card-icon">{{ ux_icon('bi:stars', {height: '32px', width: '32px'}) }}</div>
                <span>{{ 'Mon Univers'|trans }}</span>
            </a>
            <a href="{{ path('app_contact') }}" class="hero-card">
                <div class="card-icon">{{ ux_icon('streamline-pixel:interface-essential-call-center-contact-help', {height: '32px', width: '32px'}) }}</div>
                <span>{{ 'Contact'|trans }}</span>
            </a>
        </div>
    </div>
</div>
{% endblock %}