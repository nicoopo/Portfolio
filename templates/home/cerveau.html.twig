{% extends 'base.html.twig' %}

{% block title %}Mon Cerveau · Univers de Nico{% endblock %}

{% block description %}Explore mon cerveau en 3D : chaque neurone est une compétence, reliée aux projets qui l'utilisent, entourée de mes passions et de mon parcours.{% endblock %}

{% block body %}
<section class="brain-stage"
         data-controller="brain"
         data-brain-neurons-value="{{ neurones|json_encode }}"
         data-brain-passions-value="{{ passions_3d|json_encode }}"
         data-brain-souvenirs-value="{{ parcours_3d|json_encode }}"
         data-action="keydown.esc@window->brain#close">

    <h1 class="visually-hidden">Mon cerveau en 3D : compétences, projets, parcours et passions</h1>

    <div class="brain-canvas" data-brain-target="canvas"
         role="img" aria-label="Cerveau holographique en 3D : chaque point lumineux est une compétence, reliée aux autres par des synapses ; au centre, un fil de souvenirs retrace mon parcours ; autour, des nébuleuses représentent mes passions"></div>

    <p class="brain-fallback" data-brain-target="fallback">
        Ton navigateur ne supporte pas la 3D (WebGL).
        <a href="{{ path('app_competences') }}">Voir mes compétences</a>
    </p>

    {# Légende des lobes ; les boutons servent aussi au clavier et aux lecteurs d'écran #}
    <nav class="brain-legend" aria-label="Compétences">
        {# Recherche : suggestions natives (datalist), Entrée ou choix d'une suggestion = vol vers l'élément #}
        <form class="brain-search" role="search" data-action="brain#search">
            <input type="search" list="brain-names" class="brain-search-input" data-brain-target="search"
                   data-action="change->brain#search keydown->brain#clearSearchError:stop"
                   placeholder="Chercher…" aria-label="Chercher une compétence, une passion ou une étape du parcours">
            <datalist id="brain-names">
                {% for categorie in categories %}{% for competence in categorie.competences %}<option value="{{ competence.nom }}">{% endfor %}{% endfor %}
                {% for passion in passions %}<option value="{{ passion.nom }}">{% endfor %}
                {% for etape in parcours %}<option value="{{ etape.nom }}">{% endfor %}
            </datalist>
        </form>
        {% for categorie in categories %}
        <details class="brain-legend-group">
            <summary>
                <span class="brain-legend-dot" style="--dot: {{ categorie.couleur }}"></span>{{ categorie.nom }}
            </summary>
            <ul>
                {% for competence in categorie.competences %}
                <li>
                    <button type="button" data-action="brain#selectByName" data-brain-name-param="{{ competence.nom }}">
                        {{ competence.nom }}
                    </button>
                </li>
                {% endfor %}
            </ul>
        </details>
        {% endfor %}
        <details class="brain-legend-group">
            <summary>
                <span class="brain-legend-dot brain-legend-dot--nebula"></span>Passions
            </summary>
            <ul>
                {% for passion in passions %}
                <li>
                    <button type="button" data-action="brain#selectByName" data-brain-name-param="{{ passion.nom }}">
                        {{ passion.nom }}
                    </button>
                </li>
                {% endfor %}
            </ul>
        </details>
        <details class="brain-legend-group">
            <summary>
                <span class="brain-legend-dot brain-legend-dot--souvenir"></span>Parcours
            </summary>
            <ul>
                {% for etape in parcours %}
                <li>
                    <button type="button" data-action="brain#selectByName" data-brain-name-param="{{ etape.nom }}">
                        {{ etape.nom }}
                    </button>
                </li>
                {% endfor %}
            </ul>
        </details>
    </nav>

    <p class="brain-tooltip" data-brain-target="tooltip" hidden></p>

    <aside class="brain-panel" data-brain-target="panel" tabindex="-1" aria-live="polite" hidden>
        <button type="button" class="brain-panel-close" data-action="brain#close" aria-label="Fermer">×</button>
        <p class="brain-panel-category" data-brain-target="panelCategory"></p>
        <h2 class="brain-panel-title" data-brain-target="panelTitle"></h2>
        <div data-brain-target="panelBody"></div>
    </aside>

    {# Caché tant que la 3D n'a pas démarré (sans WebGL, pas de visite) #}
    <button type="button" class="brain-tour" data-brain-target="tourButton" data-action="brain#toggleTour" aria-pressed="false" hidden>Visite guidée</button>
    <button type="button" class="brain-tour brain-tour--fullscreen" data-brain-target="fullscreenButton" data-action="brain#toggleFullscreen" aria-pressed="false" hidden>Plein écran</button>

    <p class="brain-hint">Glisse pour tourner · Clic droit ou flèches pour te déplacer · Dézoome pour voir mes passions</p>
</section>
{% endblock %}
