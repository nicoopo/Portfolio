{# Pages d'erreur en prod (404, 500…) : TwigBundle cherche error<code>.html.twig, puis ce fichier.
   Langue : celle de l'adresse demandée (/en/… → anglais, ErreurLangueListener). #}
{% extends 'base.html.twig' %}

{% set introuvable = status_code == 404 %}

{% block title %}{{ (introuvable ? 'Page introuvable' : 'Une erreur est survenue')|trans }} - Nicolas Cataluna{% endblock %}

{% block body %}
<section class="erreur-section">
    <div class="erreur-container">
        {% if introuvable %}
        {# Le « 0 » est un trou noir qui aspire les morceaux de la page #}
        <div class="erreur-code" aria-hidden="true">
            <span class="gradient">4</span><span class="erreur-trou" data-controller="trou-noir"><canvas data-trou-noir-target="canvas"></canvas></span><span class="gradient">4</span>
        </div>
        {% else %}
        <span class="erreur-code gradient" aria-hidden="true">{{ status_code }}</span>
        {% endif %}
        <h1>{{ (introuvable ? 'Page introuvable' : 'Une erreur est survenue')|trans }}</h1>
        <p>
            {% if introuvable %}
                {{ 'Cette page n’existe pas, ou plus. Elle s’est peut-être perdue quelque part dans l’univers.'|trans }}
            {% else %}
                {{ 'Le serveur a rencontré un problème. Il a été signalé ; réessayez dans quelques instants.'|trans }}
            {% endif %}
        </p>
        <nav class="erreur-liens" aria-label="{{ 'Pages principales'|trans }}">
            <a href="{{ path('app_home') }}" class="btn btn-galactic btn-galactic-primary">{{ 'Accueil'|trans }}</a>
            <a href="{{ path('app_cerveau') }}" class="btn btn-galactic btn-galactic-outline-light">{{ 'Mon Cerveau'|trans }}</a>
            <a href="{{ path('app_projects') }}" class="btn btn-galactic btn-galactic-outline-light">{{ 'Projets'|trans }}</a>
        </nav>

        {% if introuvable %}
        {# Mini-jeu (asteroides_controller.js) : lancé seulement par le bouton ; les liens restent au-dessus #}
        <div class="jeu-404" data-controller="asteroides" data-asteroides-textes-value="{{ {
                perdu: 'Touché ! Tu as tenu %score% s.'|trans,
                record: 'Nouveau record : %score% s !'|trans,
                meilleur: 'Record : %score% s'|trans,
                rejouer: 'Rejouer'|trans,
            }|json_encode }}">
            <p class="jeu-404-titre">{{ 'En attendant : évite les astéroïdes'|trans }}
                <small>{{ 'Flèches ← → ou glisse le doigt'|trans }}</small></p>
            <button type="button" class="btn btn-galactic btn-galactic-outline-light" data-asteroides-target="jouer" data-action="asteroides#jouer">{{ 'Jouer'|trans }}</button>
            <canvas class="jeu-404-terrain" data-asteroides-target="canvas" tabindex="-1" hidden
                    aria-label="{{ 'Jeu : un vaisseau évite des astéroïdes qui tombent'|trans }}"></canvas>
            <p class="jeu-404-score" role="status" data-asteroides-target="score"></p>
            <p class="jeu-404-record" data-asteroides-target="record"></p>
        </div>
        {% endif %}
    </div>
</section>
{% endblock %}
