{% extends 'base.html.twig' %}

{% block title %}{{ 'Compétences'|trans }} · Nicolas Cataluna{% endblock %}

{% block description %}{{ 'Mes compétences techniques et humaines : front-end, back-end, réseaux, outils et soft skills.'|trans }}{% endblock %}

{% block body %}
<div class="skills-page">

  <section class="skills-header">
    <h1>{{ 'Mes compétences'|trans }}</h1>
    <p>{{ 'Un aperçu de mes connaissances techniques et humaines'|trans }}</p>
    <a href="{{ path('app_comparateur') }}" class="btn btn-galactic btn-galactic-outline-light mt-3">{{ 'Comparer avec votre offre'|trans }}</a>
  </section>

  {# Système solaire en 3D (systeme_controller.js). Décor : tout ce qu'il montre est dans la liste en dessous #}
  <section class="systeme-solaire" data-controller="systeme" aria-hidden="true" hidden
           data-systeme-categories-value="{{ systeme|json_encode }}"
           data-systeme-texts-value="{{ {projets: 'Projets'|trans, aucun: 'Pas encore utilisée dans un projet'|trans, cerveau: 'Voir ce neurone dans mon cerveau'|trans}|json_encode }}">
    <p class="systeme-aide">{{ 'Chaque planète est une compétence, ses lunes sont les projets qui l’utilisent. Clique dessus pour les visiter.'|trans }}</p>
    <div class="systeme-scene" data-systeme-target="scene"></div>
    <span class="systeme-etiquette" data-systeme-target="label" hidden></span>
    <div class="systeme-fiche" data-systeme-target="card" hidden>
      <button type="button" class="systeme-fermer" data-action="systeme#close" tabindex="-1" title="{{ 'Fermer'|trans }}">×</button>
      <p class="systeme-categorie" data-systeme-target="category"></p>
      <p class="systeme-nom" data-systeme-target="name"></p>
      <ul data-systeme-target="projects"></ul>
      <a href="{{ path('app_cerveau') }}" data-systeme-target="brain" tabindex="-1"></a>
    </div>
  </section>

  <section class="skills-grid" data-controller="constellation">
    {% for categorie in categories %}
    {% set competences = categorie.competences %}
    {% set ciel = constellation(competences|length, loop.index) %}
    <div class="skills-category" style="--etoile: {{ categorie.couleur }}">
      <h2>{{ categorie|loc('nom') }}</h2>

      {# Chaque compétence est une étoile ; plus elle sert de projets, plus elle brille.
         Décor : les mêmes liens sont dans la liste en dessous (survol de l'un = éclaire l'autre, constellation_controller.js) #}
      <svg class="ciel-competences" viewBox="0 0 320 180" aria-hidden="true" focusable="false">
        {% for lien in ciel.liens %}
          {% set a, b = ciel.etoiles[lien[0]], ciel.etoiles[lien[1]] %}
          <line x1="{{ a[0] }}" y1="{{ a[1] }}" x2="{{ b[0] }}" y2="{{ b[1] }}"/>
        {% endfor %}
        {% for competence in competences %}
          {% set e = ciel.etoiles[loop.index0] %}
          <a href="{{ path('app_cerveau') }}#{{ competence|loc('nom')|url_encode }}" tabindex="-1" class="etoile" data-competence="{{ competence.id }}">
            <circle cx="{{ e[0] }}" cy="{{ e[1] }}" r="{{ 2.5 + min(competence.projets|length, 4) }}"/>
            <text x="{{ e[0] }}" y="{{ e[1] - 9 }}">{{ competence|loc('nom') }}</text>
          </a>
        {% endfor %}
      </svg>

      <ul class="skills-cards">
        {% for competence in competences %}
        <li class="skill-card" data-competence="{{ competence.id }}">
          <a class="skill-nom" href="{{ path('app_cerveau') }}#{{ competence|loc('nom')|url_encode }}" title="{{ 'Voir ce neurone dans mon cerveau'|trans }}">{{ competence|loc('nom') }}</a>
          {% if competence.projets is not empty %}
          <span class="skill-projets">
            {% for projet in competence.projets %}<a href="{{ path('app_project', {slug: projet.slug}) }}">{{ projet|loc('titre') }}</a>{% endfor %}
          </span>
          {% endif %}
        </li>
        {% endfor %}
      </ul>
    </div>
    {% endfor %}
  </section>
</div>
{% endblock %}
