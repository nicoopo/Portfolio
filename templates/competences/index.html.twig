{% extends 'base.html.twig' %}

{% block title %}Compétences – Nicolas Cataluna{% endblock %}

{% block body %}
<div class="skills-page">

  <section class="skills-header">
    <h1>Mes Compétences</h1>
    <p>Un aperçu de mes connaissances techniques et humaines</p>
  </section>

  <section class="skills-grid">
    {% for nom, categorie in categories %}
    <div class="skills-category">
      <h2>{{ nom }}</h2>
      <div class="skills-cards">
        {% for competence in categorie.competences %}
        <div class="skill-card"><span>{{ competence }}</span></div>
        {% endfor %}
      </div>
    </div>
    {% endfor %}
  </section>
</div>
{% endblock %}
