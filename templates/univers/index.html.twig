{% extends 'base.html.twig' %}

{% block title %}{{ 'Mon Univers - Portfolio'|trans }}{% endblock %}

{% block description %}{{ 'Mon CV, ma lettre de motivation et mon parcours scolaire, du brevet au BTS SIO.'|trans }}{% endblock %}

{% block body %}
<section class="univers-section container py-5" data-controller="pdf">

    <h1 class="text-center mb-5 gradient fw-bold display-5">{{ 'Mon Univers'|trans }}</h1>

    <section class="cv-section text-center py-5">
    <h2 class="gradient mb-4">{{ 'Mon CV'|trans }}</h2>

    <div class="d-flex justify-content-center gap-3 flex-wrap mb-5">
        {# CV généré depuis la base, dans la langue de la page (page /CV et PDF) #}
        <a href="{{ path('app_cv') }}" class="btn btn-galactic btn-galactic-outline-light">
            {{ ux_icon('bi:eye', {height: '20px', width: '20px', 'aria-hidden': 'true'}) }} {{ 'Voir le CV'|trans }}
        </a>

        {# Le PDF du CV affiché ici, dans la visionneuse, sans le télécharger #}
        <button type="button"
            class="btn btn-galactic btn-galactic-outline-light"
            data-action="pdf#show"
            data-pdf-url-param="{{ path('app_univers_cv_preview', {theme: 'light'}) }}"
            data-pdf-title-param="{{ 'Mon CV'|trans }}">
            {{ ux_icon('bi:file-earmark-pdf', {height: '20px', width: '20px', 'aria-hidden': 'true'}) }} {{ 'Aperçu PDF'|trans }}
        </button>

        <a href="{{ path('app_cv_download', {theme: 'light'}) }}" class="btn btn-galactic btn-galactic-primary">
            {{ ux_icon('bi:download', {height: '20px', width: '20px', 'aria-hidden': 'true'}) }} {{ 'Télécharger'|trans }}
        </a>
    </div>

    <h2 class="gradient mb-4">{{ 'Ma lettre de motivation'|trans }}</h2>
    {# Lettre dans la langue de la page #}
    {% set lettre = app.request.locale == 'en'
        ? {pdf: 'docs/cover-letter.pdf', nom: 'Cover_Letter_Nicolas_Cataluna.pdf'}
        : {pdf: 'docs/lettre de motivation.pdf', nom: 'Lettre_Motivation_Nicolas_Cataluna.pdf'} %}

    <div class="d-flex justify-content-center gap-3 flex-wrap">
        <!-- Voir la lettre - Ouvre dans un iframe sur la même page -->
        <button type="button"
            class="btn btn-galactic btn-galactic-outline-light"
            data-action="pdf#show"
            data-pdf-url-param="{{ asset(lettre.pdf) }}"
            data-pdf-title-param="{{ 'Ma lettre de motivation'|trans }}">
            {{ ux_icon('bi:eye', {height: '20px', width: '20px', 'aria-hidden': 'true'}) }} {{ 'Voir la lettre'|trans }}
        </button>

        <!-- Télécharger la lettre -->
        <a href="{{ asset(lettre.pdf) }}"
           download="{{ lettre.nom }}"
           class="btn btn-galactic btn-galactic-primary">
            {{ ux_icon('bi:download', {height: '20px', width: '20px', 'aria-hidden': 'true'}) }} {{ 'Télécharger'|trans }}
        </a>
    </div>
    </section>

    <!-- Visualiseur PDF simple -->
    <div class="pdf-viewer-container mt-4" data-pdf-target="viewer" hidden>
        <div class="pdf-header d-flex justify-content-between align-items-center mb-3">
            <h3 class="mb-0 gradient" data-pdf-target="title">Document</h3>
            <button class="btn btn-close btn-close-white" data-action="pdf#close" aria-label="{{ 'Fermer'|trans }}"></button>
        </div>
        <div class="pdf-content">
            <iframe data-pdf-target="frame" title="{{ 'Document PDF'|trans }}" src="" frameborder="0" width="100%" height="600px" class="rounded shadow"></iframe>
        </div>
    </div>

    <h2 class="text-center mb-5 gradient fw-bold display-6">{{ 'Mon parcours'|trans }}</h2>

    {# Frise chronologique : de la plus ancienne étape à la plus récente (position 1 = la plus récente) #}
    <ol class="frise">
        {% for etape in parcours|reverse %}
        {% set en_cours = (etape.dates|split('-')|last|trim) >= 'now'|date('Y') %}
        <li class="frise-etape{{ en_cours ? ' frise-etape--en-cours' }}" id="etape-{{ etape.id }}">
            <span class="frise-dates">{{ etape.dates }}{% if en_cours %} <span class="frise-badge">{{ 'En cours'|trans }}</span>{% endif %}</span>
            <article class="frise-carte">
                <h3 class="frise-titre">{{ etape|loc('intitule') }}</h3>
                {% if etape.specialite %}<p class="frise-specialite">{{ etape|loc('specialite') }}</p>{% endif %}
                <p class="frise-ecole">{{ etape.ecole }} · {{ etape.lieu }}</p>
                <p class="frise-resultat">{{ etape|loc('resultat') }}</p>
                <a class="frise-lien" href="{{ path('app_cerveau') }}#{{ etape|loc('nom')|url_encode }}">{{ 'Voir ce souvenir dans mon cerveau'|trans }}</a>
            </article>
        </li>
        {% endfor %}
    </ol>
</section>
{% endblock %}
